# Telegram Configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# AI Priority (comma separated, will fallback in order)
# Options: sambanova, groq, gemini
AI_PRIORITY=sambanova,groq,gemini
TIMEZONE=America/Caracas

# AI API Keys
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
SAMBANOVA_API_KEY=YOUR_SAMBANOVA_API_KEY_HERE

# AI Models Configuration
SAMBANOVA_MODEL=DeepSeek-V3.1
GROQ_MODEL=mixtral-8x7b-32768

# Cat API for Version Bumps (Optional)
CAT_API_KEY=YOUR_CAT_API_KEY_HERE

# Repositories to monitor (RSS URLs)
PROXMOX_BACKUP_RSS=https://git.proxmox.com/?p=proxmox-backup.git;a=rss
PVE_MANAGER_RSS=https://git.proxmox.com/?p=pve-manager.git;a=rss

# Check interval in seconds (default 5 minutes)
CHECK_INTERVAL=300
